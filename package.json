{
  "name": "tfl-status-vs-reality",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun run db:migrate && vite",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "wrangler types --check && tsc -b",
    "types": "wrangler types",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "bun scripts/check-size.ts",
    "reference": "bun scripts/build-reference.ts",
    "fixtures": "bun scripts/capture-fixtures.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
