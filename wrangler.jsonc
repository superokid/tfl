{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tfl-status-vs-reality",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Live at https://tfl-status-vs-reality.kelvinok52.workers.dev. No per-version preview URLs:
  // only the deployed version is public.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // The React app is served as static assets; only /api/* reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  // Secret names only, never values. Local: .dev.vars (gitignored).
  // Production: `wrangler secret put TFL_APP_KEY`. Declaring it here keeps generated types
  // identical on every machine and in CI, whether or not .dev.vars exists.
  "secrets": {
    "required": ["TFL_APP_KEY"]
  },
  // Snapshot and refresh lease (ADR-002/006). Before the first deploy, create it near London:
  //   wrangler d1 create tfl-status-vs-reality --location weur   → add the printed database_id here.
  // Without an id Wrangler would auto-create it near the deployer. Local dev: bun run db:migrate.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tfl-status-vs-reality",
      "migrations_dir": "migrations"
    }
  ]
}
