{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "better-tfl",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Live at https://better-tfl.kelvinok52.workers.dev. No per-version preview URLs:
  // only the deployed version is public.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    // The React app is served as static assets; only /api/* reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Per-IP limit on on-demand endpoints, so one client can't exhaust the TfL key (ADR-014).
  // Per Cloudflare location; period must be 10 or 60 s.
  "ratelimits": [
    {
      "name": "IP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Errors (console.error) are logged; the per-request invocation log is not: it counts against the
  // account-wide Workers Logs allowance (ADR-009). Query strings are redacted: /api/nearby carries a position.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false }
  },
  // Secret names only, never values. Local: .dev.vars (gitignored).
  // Production: `wrangler secret put TFL_APP_KEY`. Declaring it here keeps generated types
  // identical on every machine and in CI, whether or not .dev.vars exists.
  "secrets": {
    "required": ["TFL_APP_KEY"]
  },
  // Snapshot and refresh lease (ADR-002/006). Created near London (--location weur). The id is pinned:
  // without it, a deploy from a checkout with no .wrangler state auto-creates a new database near the
  // deployer. Local dev: bun run db:migrate.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tfl-status-vs-reality",
      "database_id": "20609550-549d-4239-a878-2e608b78dd33",
      "migrations_dir": "migrations"
    }
  ]
}
